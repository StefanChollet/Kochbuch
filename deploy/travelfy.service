# Erzeugt von tools/build.js - Travelfy auf trex
[Unit]
Description=Travelfy (https://chollet.corvent.ch/travelfy/)
After=network.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APPS_ROOT@/travelfy
ExecStart=/usr/bin/env node server.js
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=TRAVELFY_PORT=3001
Environment=TRAVELFY_HOST=127.0.0.1
Environment=TRAVELFY_BASE=/travelfy
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
